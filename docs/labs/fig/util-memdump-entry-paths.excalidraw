   "link": null,
   "locked": false,
   "fontSize": 13,
   "fontFamily": 3,
   "text": "The 2026 contract is memdump(char *fmt, char *data, int len).\nOnly the argc == 2 path ever computes a real length, and it drops\nit; the built-in calls never had one. Reconcile the declaration,\nall six call sites, and the grader as one change.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The 2026 contract is memdump(char *fmt, char *data, int len).\nOnly the argc == 2 path ever computes a real length, and it drops\nit; the built-in calls never had one. Reconcile the declaration,\nall six call sites, and the grader as one change.",
   "lineHeight": 1.25,
   "baseline": 10.4,
   "autoResize": true
  },
  {
   "id": "t045",
   "type": "text",
   "x": 40,
   "y": 796,
   "width": 704,
   "height": 37,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a00045",
   "roundness": null,
   "seed": 1045,
   "version": 1,
   "versionNonce": 1045,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1788307200000,
   "link": null,
   "locked": false,
   "fontSize": 15,
   "fontFamily": 3,
   "text": "An address alone cannot justify a load. What carries the valid byte count into\nmemdump() is the design decision this exercise turns on.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "An address alone cannot justify a load. What carries the valid byte count into\nmemdump() is the design decision this exercise turns on.",
   "lineHeight": 1.25,
   "baseline": 12.0,
   "autoResize": true
  }
 ],

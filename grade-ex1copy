#!/usr/bin/env python3

import re

from gradelib import *


r = Runner(save("xv6.out"))


@test(1, "copies finite piped input")
def test_piped_input():
    payload = "xv6-ex1copy-payload-0123456789-abcdefghijklmnopqrstuvwxyz-ABCDEFGHIJKL"
    r.run_qemu(shell_script([
        "echo %s | ex1copy" % payload,
        "echo DONE",
    ]))
    r.match("^%s$" % payload, "^DONE$",
            no=["exec .* failed", "ex1copy: .* error"])


@test(1, "interactive input ends with Ctrl-d")
def test_interactive_eof():
    input_lines = ("first", "second")
    line_counts = {line: 0 for line in input_lines}

    def drive_input(runner):
        def send_first(_line):
            runner.qemu.write("%s\n" % input_lines[0])

        def send_next(line):
            line = line.rstrip("\r")
            line_counts[line] += 1
            if line == input_lines[0] and line_counts[line] == 2:
                runner.qemu.write("%s\n" % input_lines[1])
            elif line == input_lines[1] and line_counts[line] == 2:
                runner.qemu.write(b"\x04")

        call_on_line(r"^\$ ex1copy\r?$", send_first)(runner)
        call_on_line(r"^(first|second)\r?$", send_next)(runner)

    r.run_qemu(shell_script(["ex1copy", "echo DONE"]), drive_input, timeout=10)
    copied = re.findall(r"(?m)^(first|second)$", r.qemu.output)
    assert_equal(copied.count("first"), 2, "console echo plus copied first line")
    assert_equal(copied.count("second"), 2, "console echo plus copied second line")
    r.match("^DONE$", no=["ex1copy: .* error"])


@test(1, "reports a closed output pipe")
def test_closed_output_pipe():
    r.run_qemu(
        # README is larger than xv6 PIPESIZE (512), so ex1copy keeps writing
        # until it observes the closed reader.
        shell_script(["ex1copy < README | echo done < README"]),
        make_args=["CPUS=1"],
        timeout=10,
    )
    prompts = re.findall(r"(?m)^\$ ", r.qemu.output)
    assert_equal(len(prompts), 2, "initial and returned shell prompts")
    r.match("^done$", "^ex1copy: write error$")


run_tests()

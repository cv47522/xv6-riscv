{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "xv6: start QEMU for GDB",
            "type": "shell",
            "command": "make",
            "args": ["CPUS=1", "qemu-gdb"],
            "options": { "cwd": "${workspaceFolder}" },
            "isBackground": true,
            "problemMatcher": {
                "owner": "xv6",
                "pattern": {
                    "regexp": "^(.*?):([0-9]+):([0-9]+): (warning|error): (.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".",
                    "endsPattern": "^\\*\\*\\* Now run 'gdb' in another window\\.$"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            }
        },
        {
            "label": "xv6: stop QEMU GDB",
            "type": "shell",
            "command": "pkill -TERM -f \"qemu-system-riscv64.*-gdb tcp::$(make -s print-gdbport)\" || true",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        }
    ]
}
